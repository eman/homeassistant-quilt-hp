{
  "title": "Quilt",
  "config": {
    "step": {
      "user": {
        "title": "Connect to Quilt",
        "description": "Enter the email address associated with your Quilt account. A one-time passcode will be sent to that address.",
        "data": {
          "email": "Email address"
        },
        "data_description": {
          "email": "The email address used to sign in to the Quilt app."
        }
      },
      "otp": {
        "title": "Enter passcode",
        "description": "Enter the one-time passcode sent to {email}.",
