        "title": "Re-authenticate Quilt",
        "description": "Your Quilt session for {email} has expired. Click submit to receive a new passcode."
      },
      "reconfigure": {
        "title": "Reconfigure Quilt",
        "description": "Update your Quilt email address or re-authenticate. A passcode will be sent to the email you provide.",
        "data": {
          "email": "Email address"
        },
        "data_description": {
          "email": "The email address used to sign in to the Quilt app."
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the Quilt cloud. Check your internet connection and try again.",
      "invalid_auth": "Authentication failed. Please check the passcode or email address and try again.",
      "unknown": "An unexpected error occurred."
    },
    "abort": {
      "already_configured": "This Quilt home is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration successful. Your integration has been updated.",
      "reconfigure_failed": "Reconfiguration failed. Please try again.",
      "unique_id_mismatch": "The new account does not contain the home this entry was configured for."
    }
  },
  "options": {
    "step": {
